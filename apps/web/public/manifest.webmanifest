{
  "id": "/",
  "name": "pwamart: the app store for web apps",
  "short_name": "pwamart",
  "description": "Find and install Progressive Web Apps on any phone, tablet or computer.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f4ed",
  "theme_color": "#16211d",
  "categories": ["utilities", "productivity", "developer"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Browse apps", "url": "/apps", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Submit an app", "url": "/console/submit", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
